# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Get this from Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Minutes before an unanswered task auto-expires and is cleaned up (default: 10)
TASK_TTL_MINUTES=10

# ── Solana ─────────────────────────────────────────────────────────────────
# Base58 private key of the "Master Wallet" that funds payouts.
# Fund it with Devnet SOL at https://faucet.solana.com
# To export from Phantom: Settings > Export Private Key
MASTER_WALLET_PRIVATE_KEY=your_base58_private_key_here

# Amount of SOL to pay per completed task (default: 0.001)
PAYOUT_AMOUNT_SOL=0.001

# ── Google Gemini ───────────────────────────────────────────────────────────
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs ─────────────────────────────────────────────────────────────
# Get key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID — default is a calm, authoritative English voice.
# Browse voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
